<main
  class="universe"
  data-secret-1="<%= t('secrets.secret_01') %>"
  data-secret-2="<%= t('secrets.secret_02') %>"
  data-secret-3="<%= t('secrets.secret_03') %>"
>

  <!-- CUSTOM CURSOR -->
  <div class="custom-cursor" aria-hidden="true">
    <div class="cursor-dot"></div>
    <div class="cursor-ring">
      <span class="cursor-label"></span>
    </div>
  </div>

  <!-- COSMIC TOAST / EASTER EGGS -->
  <div class="cosmic-toast" id="cosmic-toast" aria-live="polite" aria-atomic="true"></div>

  <!-- =========================================
       00 / PORTAL
  ========================================== -->

  <section class="portal" id="portal">

    <!-- NAVIGATION -->

    <nav class="navigation">

      <a href="#portal" class="universe-logo">
        <span class="logo-symbol easter-egg-trigger" data-secret="1" title="✦" role="button" tabindex="0">✦</span>
        <span class="logo-name">ASHILAY'S UNIVERSE</span>
      </a>

      <div class="nav-actions">

        <!-- IDIOMA -->

        <div class="language-control">

          <button
            class="language-toggle"
            type="button"
            aria-expanded="false"
            aria-label="<%= t("navigation.language") %>"
          >
            <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>

            <span class="language-current">
              <%= I18n.locale.to_s.upcase %>
            </span>

            <svg class="nav-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="language-menu" hidden>

            <span class="panel-label">
              <%= t("navigation.language") %>
            </span>

            <%= link_to "PT — Português",
                        url_for(locale: "pt-BR"),
                        class: "language-option",
                        data: { turbo: false } %>

            <%= link_to "EN — English",
                        url_for(locale: "en"),
                        class: "language-option",
                        data: { turbo: false } %>

            <%= link_to "ES — Español",
                        url_for(locale: "es"),
                        class: "language-option",
                        data: { turbo: false } %>

          </div>

        </div>


        <!-- TEMA / REALIDADE -->

        <button
          class="theme-toggle"
          type="button"
          aria-label="<%= t("navigation.theme") %>"
        >
          <span class="theme-icon-box" aria-hidden="true">
            <svg class="nav-icon theme-svg-dark" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="nav-icon theme-svg-light" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </span>

          <span class="theme-label">
            <%= t("navigation.theme") %>
          </span>
        </button>


        <!-- ACESSIBILIDADE -->

        <button
          class="accessibility-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="accessibility-panel"
          aria-label="<%= t("navigation.accessibility") %>"
        >
          <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="7.5" r="1.5" fill="currentColor"></circle>
            <path d="M7.5 12c3-1.2 6-1.2 9 0"></path>
            <path d="M12 12v4.5"></path>
            <path d="M9.5 19.5 12 16.5 14.5 19.5"></path>
          </svg>

          <span class="accessibility-label">
            <%= t("navigation.accessibility") %>
          </span>
        </button>


        <!-- MENU -->

        <button
          class="menu-button"
          type="button"
          aria-label="<%= t("navigation.menu") %>"
          aria-expanded="false"
          aria-controls="menu-overlay"
        >
          <span class="menu-icon-bars" aria-hidden="true">
            <span class="bar bar-1"></span>
            <span class="bar bar-2"></span>
            <span class="bar bar-3"></span>
          </span>

          <span class="menu-label">
            <%= t("navigation.menu") %>
          </span>
        </button>

      </div>

    </nav>


    <!-- =========================================
         ACESSIBILIDADE
    ========================================== -->

    <aside
      class="accessibility-panel"
      id="accessibility-panel"
      aria-hidden="true"
    >

      <div class="panel-header">

        <div>
          <span class="panel-index"><%= t("accessibility.panel_index") %></span>

          <h2>
            <%= t("accessibility.title") %>
          </h2>
        </div>

        <button
          class="accessibility-close"
          type="button"
          aria-label="<%= t("accessibility.close") %>"
        >
          ×
        </button>

      </div>


      <div class="accessibility-options">

        <!-- TAMANHO DO TEXTO -->

        <div class="accessibility-group">

          <span class="option-title">
            <%= t("accessibility.text_size") %>
          </span>

          <div class="text-size-controls">

            <button type="button" data-font-size="small">
              A−
            </button>

            <button type="button" data-font-size="normal">
              A
            </button>

            <button type="button" data-font-size="large">
              A+
            </button>

          </div>

        </div>


        <!-- CONTRASTE -->

        <button
          class="accessibility-option"
          data-accessibility="contrast"
          type="button"
        >
          <span class="accessibility-icon">◑</span>

          <span>
            <%= t("accessibility.contrast") %>
          </span>
        </button>


        <!-- MOVIMENTO -->

        <button
          class="accessibility-option"
          data-accessibility="motion"
          type="button"
        >
          <span class="accessibility-icon">≋</span>

          <span>
            <%= t("accessibility.motion") %>
          </span>
        </button>


        <!-- LIBRAS -->

        <% if I18n.locale == :"pt-BR" %>

          <button
            class="accessibility-option libras-toggle"
            type="button"
          >
            <span class="accessibility-icon">🤟</span>

            <span>
              <%= t("accessibility.libras") %>
            </span>
          </button>

        <% end %>

      </div>

    </aside>


    <!-- =========================================
         FULLSCREEN MENU
    ========================================== -->

    <div
      class="menu-overlay"
      id="menu-overlay"
      aria-hidden="true"
      role="dialog"
      aria-label="<%= t("navigation.menu") %>"
    >

      <div class="menu-wrapper">

        <div class="menu-header">

          <div class="menu-reality">

            <span class="menu-reality-label">
              <%= t("menu.current_reality") %>
            </span>

            <strong
              class="menu-reality-value"
              data-midnight="<%= t("menu.midnight") %>"
              data-daydream="<%= t("menu.daydream") %>"
            >
              <%= t("menu.midnight") %>
            </strong>

          </div>

          <button
            class="menu-close"
            type="button"
            aria-label="<%= t("menu.close") %>"
          >
            ×
          </button>

        </div>


        <nav class="menu-navigation" aria-label="<%= t("navigation.menu") %>">

          <a href="#portal" class="menu-link">
            <span class="menu-link-index">00</span>
            <span><%= t("menu.nav_portal") %></span>
          </a>

          <a href="#about" class="menu-link">
            <span class="menu-link-index">01</span>
            <span><%= t("menu.nav_universe") %></span>
          </a>

          <a href="#worlds" class="menu-link">
            <span class="menu-link-index">02</span>
            <span><%= t("menu.nav_worlds") %></span>
          </a>

          <a href="#work" class="menu-link">
            <span class="menu-link-index">03</span>
            <span><%= t("menu.nav_work") %></span>
          </a>

          <a href="#journey" class="menu-link">
            <span class="menu-link-index">04</span>
            <span><%= t("menu.nav_journey") %></span>
          </a>

          <a href="#capabilities" class="menu-link">
            <span class="menu-link-index">05</span>
            <span><%= t("menu.nav_capabilities") %></span>
          </a>

          <a href="#beyond" class="menu-link">
            <span class="menu-link-index">06</span>
            <span><%= t("menu.nav_beyond") %></span>
          </a>

          <a href="#contact" class="menu-link">
            <span class="menu-link-index">07</span>
            <span><%= t("menu.nav_contact") %></span>
          </a>

        </nav>


        <div class="menu-quick-access">

          <span class="menu-quick-label">
            <%= t("menu.quick_access") %>
          </span>

          <div class="menu-worlds">

            <a href="#world-tech" class="menu-world menu-world-tech">
              <span class="menu-world-symbol">◉</span>
              <strong class="menu-world-name"><%= t("capabilities.technology_world") %></strong>
              <span class="menu-world-type"><%= t("capabilities.technology") %></span>
            </a>

            <a href="#world-creative" class="menu-world menu-world-creative">
              <span class="menu-world-symbol">◇</span>
              <strong class="menu-world-name"><%= t("capabilities.creative_world") %></strong>
              <span class="menu-world-type"><%= t("capabilities.creative") %></span>
            </a>

            <a href="#world-strategy" class="menu-world menu-world-strategy">
              <span class="menu-world-symbol">✦</span>
              <strong class="menu-world-name"><%= t("capabilities.strategy_world") %></strong>
              <span class="menu-world-type"><%= t("capabilities.strategy") %></span>
            </a>

          </div>

        </div>

      </div>

    </div>


    <!-- =========================================
         ATMOSFERA
    ========================================== -->

    <div class="portal-atmosphere" aria-hidden="true">

      <span class="orb orb-one"></span>
      <span class="orb orb-two"></span>
      <span class="orb orb-three"></span>

      <span class="star star-one">✦</span>
      <span class="star star-two">·</span>
      <span class="star star-three">✦</span>

    </div>


    <!-- =========================================
         CONTEÚDO PRINCIPAL
    ========================================== -->

    <div class="portal-content">

      <span class="portal-symbol">✦</span>

      <p class="portal-code">
        <%= t("portal.entering") %>
      </p>

      <h1>
        <%= t("portal.title_one") %>

        <span>
          <%= t("portal.title_two") %>
        </span>
      </h1>

      <p class="portal-description">
        <%= t("portal.description") %>
      </p>

      <a href="#about" class="enter-button">

        <span>
          <%= t("portal.enter") %>
        </span>

        <span class="enter-arrow">↓</span>

      </a>

    </div>


    <div class="portal-footer">

      <span>
        <%= t("portal.location") %>
      </span>

      <span>
        <%= t("portal.portfolio") %>
      </span>

    </div>

  </section>


  <!-- =========================================
       01 / THE UNIVERSE
  ========================================== -->

  <section class="about section" id="about">

    <span class="section-index">
      <%= t("about.index") %>
    </span>

    <div class="about-grid">

      <div class="about-heading">

        <h2>
          <%= t("about.title_one") %>

          <span>
            <%= t("about.title_two") %>
          </span>

          <%= t("about.title_three") %>
        </h2>

        <div class="about-worlds">

          <span>
            <%= t("about.technology") %>
          </span>

          <span>
            <%= t("about.creativity") %>
          </span>

          <span>
            <%= t("about.strategy") %>
          </span>

        </div>

      </div>


      <div class="about-content">

        <div class="photo-placeholder">

          <img src="/images/Minha%20foto.jpg" alt="Ashilay Oliveira" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 1;">

          <div class="photo-orbit" style="z-index: 2; pointer-events: none;"></div>

          <span class="photo-star photo-star-one" style="z-index: 2; pointer-events: none;">✦</span>
          <span class="photo-star photo-star-two" style="z-index: 2; pointer-events: none;">·</span>

        </div>


        <div class="about-text">

          <p class="about-highlight">

            <%= t("about.introduction") %>

            <strong>
              <%= t("about.highlight") %>
            </strong>

          </p>

          <p>
            <%= t("about.paragraph_one") %>
          </p>

          <p>
            <%= t("about.paragraph_two") %>
          </p>

        </div>

      </div>

    </div>


    <div class="about-details">

      <div>
        <span><%= t("about.detail_field") %></span>
        <strong><%= t("about.detail_field_value") %></strong>
      </div>

      <div>
        <span><%= t("about.detail_location") %></span>
        <strong><%= t("about.detail_location_value") %></strong>
      </div>

      <div>
        <span><%= t("about.detail_language") %></span>
        <strong><%= t("about.detail_language_value") %></strong>
      </div>

      <div>
        <span><%= t("about.detail_intersection") %></span>
        <strong><%= t("about.detail_intersection_value") %></strong>
      </div>

    </div>

  </section>


  <!-- =========================================
       02 / WORLDS
  ========================================== -->

  <section class="worlds" id="worlds">

    <div class="worlds-wrapper">

      <div class="worlds-heading">

        <span class="section-index">
          <%= t("worlds.index") %>
        </span>

        <p class="worlds-eyebrow">
          <%= t("worlds.eyebrow") %>
        </p>

        <h2>
          <%= t("worlds.select") %>

          <span>
            <%= t("worlds.world") %>
          </span>
        </h2>

        <p class="worlds-description">
          <%= t("worlds.description") %>
        </p>

        <!-- EXPLORATION PROGRESS HUD -->
        <div class="worlds-hud">
          <span class="worlds-hud-label"><%= t("worlds.explored_label") %></span>
          <div class="worlds-hud-indicators">
            <span class="hud-pip" data-world-pip="tech" title="The Lab">◉</span>
            <span class="hud-pip" data-world-pip="creative" title="The Studio">◇</span>
            <span class="hud-pip" data-world-pip="strategy" title="The Forge">✦</span>
          </div>
          <span class="worlds-hud-count" id="worlds-hud-count">0 / 3</span>
        </div>

      </div>

<div class="world-grid">

  <!-- =====================================
       TECHNOLOGY
  ====================================== -->

  <article
    class="world-card world-tech"
    id="world-tech"
  >

    <span class="world-index">
      01
    </span>

    <span class="world-symbol">
      ◉
    </span>

    <div class="world-information">

      <h3>
        TECHNOLOGY
      </h3>

      <h4>
        THE LAB
      </h4>

      <ul>
        <li><%= t("worlds.tech_item_1") %></li>
        <li><%= t("worlds.tech_item_2") %></li>
        <li><%= t("worlds.tech_item_3") %></li>
        <li><%= t("worlds.tech_item_4") %></li>
        <li><%= t("worlds.tech_item_5") %></li>
      </ul>

    </div>

    <a
      href="#project-reelist"
      class="explore-link"
      aria-label="Explorar The Lab e projetos de tecnologia"
    >

      <span>
        <%= t("worlds.explore") %>
      </span>

      <span>
        ↗
      </span>

    </a>

  </article>


  <!-- =====================================
       CREATIVE
  ====================================== -->

  <article
    class="world-card world-creative"
    id="world-creative"
  >

    <span class="world-index">
      02
    </span>

    <span class="world-symbol">
      ◇
    </span>

    <div class="world-information">

      <h3>
        CREATIVE
      </h3>

      <h4>
        THE STUDIO
      </h4>

      <ul>
        <li><%= t("worlds.creative_item_1") %></li>
        <li><%= t("worlds.creative_item_2") %></li>
        <li><%= t("worlds.creative_item_3") %></li>
        <li><%= t("worlds.creative_item_4") %></li>
        <li><%= t("worlds.creative_item_5") %></li>
      </ul>

    </div>

    <a
      href="#project-creative"
      class="explore-link"
      aria-label="Explorar The Studio e projetos criativos"
    >

      <span>
        <%= t("worlds.explore") %>
      </span>

      <span>
        ↗
      </span>

    </a>

  </article>


  <!-- =====================================
       STRATEGY
  ====================================== -->

  <article
    class="world-card world-strategy"
    id="world-strategy"
  >

    <span class="world-index">
      03
    </span>

    <span class="world-symbol">
      ✦
    </span>

    <div class="world-information">

      <h3>
        STRATEGY
      </h3>

      <h4>
        THE FORGE
      </h4>

      <ul>
        <li><%= t("worlds.strategy_item_1") %></li>
        <li><%= t("worlds.strategy_item_2") %></li>
        <li><%= t("worlds.strategy_item_3") %></li>
        <li><%= t("worlds.strategy_item_4") %></li>
        <li><%= t("worlds.strategy_item_5") %></li>
      </ul>

    </div>

    <a
      href="#project-strategy"
      class="explore-link"
      aria-label="Explorar The Forge e projetos estratégicos"
    >

      <span>
        <%= t("worlds.explore") %>
      </span>

      <span>
        ↗
      </span>

    </a>

  </article>

</div>

    </div>

  </section>

<!-- =========================================
     03 / SELECTED WORK
========================================== -->

<section class="selected-work" id="work">

  <div class="work-wrapper">


    <!-- CABEÇALHO -->

    <header class="work-heading">

      <span class="section-index">
        <%= t("work.index") %>
      </span>

      <div class="work-heading-grid">

        <div>

          <p class="work-eyebrow">
            <%= t("work.eyebrow") %>
          </p>

          <h2>
            <%= t("work.title_one") %>

            <span>
              <%= t("work.title_two") %>
            </span>
          </h2>

        </div>


        <p class="work-introduction">
          <%= t("work.description") %>
        </p>

      </div>

    </header>


    <!-- =====================================
         PROJECT 01 / TECHNOLOGY
    ====================================== -->

    <article class="project project-tech" id="project-reelist">

      <div class="project-visual">

        <div class="project-screen project-screen-tech">

          <div class="project-image-container">
            <img src="/images/reelist.png" alt="Reelist - Cinema & Streaming Catalog UI" class="project-preview-img" loading="lazy" />
            <div class="project-image-overlay"></div>
          </div>

          <div class="preview-world-badge">
            <span class="preview-symbol">◉</span>
          </div>

        </div>

      </div>


      <div class="project-content">

        <div class="project-meta">

          <span>
            01
          </span>

          <span class="project-world">
            <%= t("work.technology") %>
          </span>

        </div>


        <div>

          <h3>
            REELIST
          </h3>

          <p class="project-category">
            <%= t("work.reelist_category") %>
          </p>


          <div class="project-tags">

            <span>JavaScript</span>
            <span>HTML</span>
            <span>CSS</span>
            <span>Arrays</span>

          </div>


          <p class="project-description">
            <%= t("work.reelist_description") %>
          </p>

        </div>


        <button
          type="button"
          class="project-link"
          data-open-case-study="reelist"
          aria-label="<%= t("work.view_case") %> Reelist"
        >

          <span>
            <%= t("work.view_case") %>
          </span>

          <span class="project-arrow">
            ↗
          </span>

        </button>

      </div>

    </article>


    <!-- =====================================
         PROJECT 02 / CREATIVE
    ====================================== -->

    <article class="project project-creative project-reverse" id="project-creative">

      <div class="project-visual">

        <div class="project-screen project-screen-creative">

          <div class="project-image-container">
            <img src="/images/creative.png" alt="Studio Astra - Creative Direction & Identity" class="project-preview-img" loading="lazy" />
            <div class="project-image-overlay"></div>
          </div>

          <div class="preview-world-badge">
            <span class="preview-symbol">◇</span>
          </div>

        </div>

      </div>


      <div class="project-content">

        <div class="project-meta">

          <span>
            02
          </span>

          <span class="project-world">
            <%= t("work.creative") %>
          </span>

        </div>


        <div>

          <h3>
            <%= t("work.creative_title") %>
          </h3>

          <p class="project-category">
            <%= t("work.creative_category") %>
          </p>


          <div class="project-tags">

            <span>Teatro</span>
            <span>Interpretação</span>
            <span>Expressão Cênica</span>
            <span>Storytelling</span>

          </div>


          <p class="project-description">
            <%= t("work.creative_description") %>
          </p>

        </div>


        <button
          type="button"
          class="project-link"
          data-open-case-study="creative"
          aria-label="<%= t("work.view_case") %> <%= t("work.creative_title") %>"
        >

          <span>
            <%= t("work.view_case") %>
          </span>

          <span class="project-arrow">
            ↗
          </span>

        </button>

      </div>

    </article>


    <!-- =====================================
         PROJECT 03 / STRATEGY
    ====================================== -->

    <article class="project project-strategy" id="project-strategy">

      <div class="project-visual">

        <div class="project-screen project-screen-strategy">

          <div class="project-image-container">
